<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Détails du contact"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#263B59"
            android:gravity="center"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/imgDetail"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:scaleType="centerCrop"
            android:contentDescription="Photo du contact" />

        <Button
            android:id="@+id/btnGalerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choisir une photo depuis la galerie" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prendre une photo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom"
            android:textStyle="bold"
            android:textColor="#263B59"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saisir le nom"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prénom"
            android:textStyle="bold"
            android:textColor="#263B59" />

        <EditText
            android:id="@+id/edtPrenom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saisir le prénom"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Téléphone"
            android:textStyle="bold"
            android:textColor="#263B59" />

        <EditText
            android:id="@+id/edtTelephone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saisir le numéro"
            android:inputType="phone"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adresse e-mail"
            android:textStyle="bold"
            android:textColor="#263B59" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saisir l'adresse e-mail"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/chkFavori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marquer comme favori"
            android:textSize="16sp"
            android:textColor="#263B59"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coordonnées GPS"
            android:textStyle="bold"
            android:textColor="#263B59"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latitude (-90 à 90)"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtLatitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: 9.5370"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Longitude (-180 à 180)"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtLongitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: -13.6785"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnVoirCarte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voir sur la carte"
            android:backgroundTint="#3B71CA"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAppeler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appeler"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envoyer un e-mail" />

        <Button
            android:id="@+id/btnEnregistrer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enregistrer"
            android:layout_marginTop="15dp"
            android:backgroundTint="#247A55" />

        <Button
            android:id="@+id/btnSupprimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supprimer le contact"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B84040" />

        <Button
            android:id="@+id/btnAnnuler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Annuler"
            android:layout_marginTop="8dp"
            android:backgroundTint="#666666" />

    </LinearLayout>

</ScrollView>
